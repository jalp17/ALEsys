# ALEsys — Variables de entorno (ejemplo)
# Copia este archivo como .env y rellena los valores

# PostgreSQL
PGHOST=localhost
PGPORT=5433
PGDATABASE=alesys
PGUSER=alesys
PGPASSWORD=alesys

# OpenRouter (requerido para extracción de entidades)
OPENROUTER_API_KEY=tu_clave_aqui

# Rutas (opcional)
# BOOKS_DIR=/ruta/a/tus/libros/
