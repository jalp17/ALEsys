# ALEsys - Variables de entorno de ejemplo
# Copia este archivo a .env y configura tus valores

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=alesys
PGUSER=alesys
PGPASSWORD=alesys

# OpenRouter (requerido para extracción de entidades)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx

# Directorio de libros (opcional - usa default si no se especifica)
# BOOKS_DIR=/home/jesus/knowledge_database/biblioteca_ia_rag/libros_ext4/books/

# Directorio sandbox (opcional)
# SANDBOX_DIR=/home/jesus/knowledge_database/sandbox/