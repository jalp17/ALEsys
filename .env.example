# ALEsys — Variables de entorno (ejemplo)
# Copia este archivo como .env y rellena los valores

# PostgreSQL
PGHOST=localhost
PGPORT=5433
PGDATABASE=alesys
PGUSER=alesys
PGPASSWORD=alesys

# OpenRouter (requerido para extracción de entidades)
OPENROUTER_API_KEY=tu_clave_aqui
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Embeddings
# Backend: sentence-transformers (default) | llama.cpp
EMBEDDING_BACKEND=sentence-transformers
# Modelo sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu

# llama.cpp / GGUF (si EMBEDDING_BACKEND=llama.cpp)
# EMBEDDING_GGUF_PATH=/ruta/a/modelo.gguf
# EMBEDDING_N_GPU_LAYERS=-1  # -1 = todas las capas en GPU, 0 = solo CPU
# EMBEDDING_N_CTX=8192
# EMBEDDING_N_BATCH=512
# EMBEDDING_USE_VULKAN=false  # true para usar Vulkan en lugar de CUDA/Metal
# EMBEDDING_LLAMA_CPP_LIB_PATH=/ruta/a/libllama.so  # librería personalizada de llama.cpp (ej. compilada con Vulkan)

# Rutas
ALESYS_DIR=/home/jesus/knowledge_database/desarrollo_git/ALEsys
BOOKS_DIR=/home/jesus/knowledge_database/biblioteca_ia_rag/libros_ext4/books/