.nox/

# === IDE ===
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
.classpath
*.launch

# === OS ===
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# === Security audit outputs ===
pip-audit.json
audit-report.json
audit.sarif
trivy-results.sarif
