# ===========================================
# ALEsys - Variables de entorno
# ===========================================
# Copiar a .env y ajustar según entorno

# === Database Core (pgvector) ===
PGHOST=localhost
PGPORT=5433
PGUSER=alesys
PGPASSWORD=alesys
PGDATABASE=alesys

# Alternativa: URL completa
# DATABASE_URL=postgresql://alesys:alesys@localhost:5433/alesys

# === Database Users (PHP - Fase 3) ===
# USERS_DB_HOST=localhost
# USERS_DB_PORT=5434
# USERS_DB_NAME=alesys_users
# USERS_DB_USER=alesys
# USERS_DB_PASSWORD=alesys

# === ALEsys Core API ===
API_ADDR=0.0.0.0:3000
RUST_LOG=alesys_api=debug,tower_http=debug

# === Service Token (PHP ↔ Rust - Fase 3) ===
# ALESYS_SERVICE_TOKEN=dev-token-change-in-production

# === LLM Configuration ===
LLM_MODEL_PATH=
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_CONTEXT_SIZE=4096

# === Embeddings ===
EMBEDDING_BACKEND=onnx
EMBEDDING_GGUF_PATH=
EMBEDDING_DIM=384

# === Paths ===
BOOKS_DIR=./books
SANDBOX_DIR=./sandbox

# === Frontend ===
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws/chat