# ===========================================
# ALEsys - Variables de entorno
# ===========================================
# Copiar a .env y ajustar según entorno

# === Database Core (pgvector) ===
POSTGRES_DB=alesys
POSTGRES_USER=alesys
POSTGRES_PASSWORD=alesys_dev_change_me
PGHOST=localhost
PGPORT=5433
PGUSER=alesys
PGDATABASE=alesys

# === Database Users (PHP - Fase 3) ===
USERS_POSTGRES_DB=alesys_users
USERS_POSTGRES_USER=alesys
USERS_POSTGRES_PASSWORD=alesys_dev_change_me

# === ALEsys Core API ===
API_ADDR=0.0.0.0:3000
RUST_LOG=alesys_api=debug,tower_http=debug

# === Service Token (PHP ↔ Rust - Fase 3) ===
ALESYS_SERVICE_TOKEN=dev-token-change-in-production

# === LLM Configuration ===
LLM_MODEL_PATH=
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_CONTEXT_SIZE=4096

# === Embeddings ===
EMBEDDING_BACKEND=onnx
EMBEDDING_GGUF_PATH=
EMBEDDING_DIM=384

# === Paths ===
BOOKS_DIR=./books
SANDBOX_DIR=./sandbox

# === Frontend ===
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws/chat