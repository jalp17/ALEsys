# Variables de entorno para ALEsys

# === Database Core (pgvector) ===
DATABASE_URL=postgresql://alesys:alesys_dev@localhost:5432/alesys

# === Database Users (PHP) ===
DB_HOST=localhost
DB_PORT=5433
DB_NAME=alesys_users
DB_USER=alesys
DB_PASSWORD=alesys_dev

# === ALEsys Core API ===
ALESYS_CORE_URL=http://localhost:3000
RUST_LOG=info

# === Service Token (PHP ↔ Rust) ===
ALESYS_SERVICE_TOKEN=dev-token-change-in-production

# === LLM Configuration ===
LLM_BACKEND=mistralrs
LLM_MODEL_PATH=/models/gguf
LLM_MODEL_NAME=google/gemma-2b-it

# === Embeddings ===
EMBEDDING_BACKEND=ort
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# === Paths ===
BOOKS_DIR=/mnt/src_file/desarrollo_git/ALEsys/books
SANDBOX_DIR=/mnt/src_file/desarrollo_git/ALEsys/sandbox

# === Frontend ===
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws/chat