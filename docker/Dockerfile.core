# Stage 1: Chef prepare
FROM rust:1.94-slim as chef
RUN cargo install cargo-chef
WORKDIR /app

# Stage 2: Planner — generate dependency recipe
FROM chef as planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Stage 3: Builder — cook deps then build app (deps cached across builds)
FROM chef as builder

# Environment variables for linker and pkg-config
ENV PKG_CONFIG_PATH=/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig
ENV LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:/usr/lib
ENV LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:/usr/lib
ENV OPENSSL_DIR=/usr
ENV OPENSSL_LIB_DIR=/usr/lib/x86_64-linux-gnu
ENV OPENSSL_INCLUDE_DIR=/usr/include
ENV PQ_LIB_DIR=/usr/lib/x86_64-linux-gnu
ENV PQ_INCLUDE_DIR=/usr/include/postgresql

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    g++ \
    make \
    git \
    pkgconf \
    libpq-dev \
    libssl-dev \
    pkg-config \
    cmake \
    libvulkan-dev \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN git config --global user.email "ci@alesys.local" && git config --global user.name "CI Bot"

# Cook dependencies (cached layer — only rebuilds when Cargo.toml changes)
COPY --from=planner /app/recipe.json .
RUN cargo chef cook --release --recipe-path recipe.json

# Build application
COPY . .
RUN cargo build --locked --release --bin alesys-api

# Stage 4: Runtime
FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libpq5 \
    ca-certificates \
    libssl3 \
    wget \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/alesys-api .

ENV RUST_LOG=info
ENV DATABASE_URL=postgresql://alesys:alesys@postgres-core:5432/alesys

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

ENTRYPOINT ["./alesys-api"]